[MASTER]

ignore-paths=src/tests
ignore=single_file_to_ignore.py
init-hook='import sys; import os; sys.path.insert(0, os.path.abspath("src"))'
[MESSAGE CONTROL]

disable=raw-checker-failed,
        bad-inline-option,
        locally-disabled,
        file-ignored,
        suppressed-message,
        useless-suppression,
        deprecated-pragma,
        use-symbolic-message-instead,
        missing-module-docstring,
        missing-function-docstring,
        missing-class-docstring

[FORMAT]

[REFACTORING]

[DESIGN]
